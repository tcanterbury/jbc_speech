{
  "name": "jbc-speech-word-addin",
  "version": "1.0.0",
  "private": true,
  "description": "JBC Speech IPA library for Microsoft Word",
  "type": "module",
  "scripts": {
    "start": "node scripts/server.mjs",
    "preview": "node scripts/server.mjs --preview",
    "test": "node --test --experimental-test-isolation=none",
    "validate": "office-addin-manifest validate manifest.xml",
    "sideload": "office-addin-debugging start manifest.xml desktop --app word --dev-server-port 3000 --no-debug --no-live-reload",
    "unsideload": "office-addin-debugging stop manifest.xml"
  },
  "devDependencies": {
    "office-addin-debugging": "^7.0.1",
    "office-addin-dev-certs": "^3.0.1",
    "office-addin-manifest": "^3.0.1"
  }
}
